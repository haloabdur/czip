{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "czip",
  "version": "0.1.0",
  "identifier": "app.czip.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "czip",
        "width": 1080,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, strong compression for files and folders",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "czip"
        ],
        "name": "czip archive",
        "description": "czip archive",
        "mimeType": "application/x-czip",
        "role": "Editor"
      },
      {
        "ext": [
          "zip",
          "7z",
          "tzst",
          "tgz",
          "txz"
        ],
        "name": "Archive",
        "role": "Viewer"
      }
    ],
    "publisher": "haloabdur",
    "copyright": "Copyright (c) 2026 haloabdur",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "longDescription": "czip compresses any mix of files and folders into .czip, .zip, .7z or .tar.zst and opens common archive formats."
  }
}
